 void ShowItemUse(edict_t *ent, int itemType);//in p_body
 void ItemDropServer(edict_t *ent,int type,int ammmoCount);
 
+// SoF Quest (VR): shots leave the gun in the hand. The client says where that is in the cvar vr_aim:
+// "1 muzzle.x y z  pitch yaw roll  hand.x y z" (world). For the time of the shot the player's view is the gun's.
+static cvar_t	*vr_aim_cvar;
+static vec3_t	vr_saved_ofs, vr_saved_ang;
+
+static bool VRAimBegin(edict_t &ent)
+{
+	float	v[10];
+	vec3_t	muzzle, hand, zero = {0, 0, 0};
+	trace_t	tr;
+
+	if (!ent.client || deathmatch->value)
+	{
+		return false;
+	}
+	if (!vr_aim_cvar)
+	{
+		vr_aim_cvar = gi.cvar("vr_aim", "0", 0);
+	}
+	if (!vr_aim_cvar || !vr_aim_cvar->string || sscanf(vr_aim_cvar->string, "%f %f %f %f %f %f %f %f %f %f",
+		&v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &v[6], &v[7], &v[8], &v[9]) < 10 || v[0] < 1)
+	{
+		return false;
+	}
+	if (ent.client->ps.fov > 0 && ent.client->ps.fov < 60)
+	{	// through the scope: where the eye looks
+		return false;
+	}
+	VectorSet(muzzle, v[1], v[2], v[3]);
+	VectorSet(hand, v[7], v[8], v[9]);
+	// not through a wall the muzzle was pushed into
+	gi.trace(hand, zero, zero, muzzle, &ent, MASK_SOLID, &tr);
+	if (tr.fraction < 1.0f)
+	{
+		VectorCopy(hand, muzzle);
+	}
+	VectorCopy(ent.client->ps.viewoffset, vr_saved_ofs);
+	VectorCopy(ent.client->ps.viewangles, vr_saved_ang);
+	VectorSubtract(muzzle, ent.s.origin, ent.client->ps.viewoffset);
+	VectorSet(ent.client->ps.viewangles, v[4], v[5], v[6]);
+	return true;
+}
+
+static void VRAimEnd(edict_t &ent)
+{
+	VectorCopy(vr_saved_ofs, ent.client->ps.viewoffset);
+	VectorCopy(vr_saved_ang, ent.client->ps.viewangles);
+}
+
+static void VRFireServer(sharedEdict_t &sh, edict_t &ent, inven_c &inven)
+{
+	bool vr = VRAimBegin(ent);
+
+	FireServer(sh, ent, inven);
+	if (vr)
+	{
+		VRAimEnd(ent);
+	}
+}
+
+static void VRAltfireServer(sharedEdict_t &sh, edict_t &ent, inven_c &inven)
+{
+	bool vr = VRAimBegin(ent);
+
+	AltfireServer(sh, ent, inven);
+	if (vr)
+	{
+		VRAimEnd(ent);
+	}
+}
+
